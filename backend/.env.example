PORT=4011
JWT_SECRET=change-me

# Ключ шифрования паролей для панели администратора (не хранить пароль в открытом виде в БД).
# 64 hex-символа (32 байта) или произвольная строка; по умолчанию берётся JWT_SECRET.
PASSWORD_VAULT_KEY=

# Панель администратора (отдельный вход, не из БД)
MODERATOR_LOGIN=moderator
MODERATOR_PASSWORD=change-moderator-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_project_db
DB_USER=postgres
DB_PASSWORD=123456

# Ссылка в письмах (публичный URL фронта; на VPS — https://docs.nerohub.ru)
APP_PUBLIC_URL=http://127.0.0.1:5173

# Mail.ru SMTP — заполните своими данными
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Реестр БАКОР <your@mail.ru>
